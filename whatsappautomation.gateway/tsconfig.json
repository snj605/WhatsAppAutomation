{
  // Type checking only ("npm run typecheck"). Node runs the .ts files directly by removing the
  // types, so the code may only use TypeScript syntax that can simply be erased (no enums, no
  // namespaces, no constructor parameter properties).
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
