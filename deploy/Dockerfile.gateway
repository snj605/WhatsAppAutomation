# syntax=docker/dockerfile:1.7
# The WhatsApp gateway (Node + Baileys). Built by CI from the repository root:
#   docker build -f deploy/Dockerfile.gateway .
# It runs the TypeScript files directly (Node 22.18+ strips the types), so there is no build step.
FROM node:22-alpine
WORKDIR /app
COPY whatsappautomation.gateway/package.json whatsappautomation.gateway/package-lock.json ./
RUN npm ci --omit=dev --no-audit --no-fund && npm cache clean --force
COPY whatsappautomation.gateway/src ./src
# NODE_OPTIONS keeps the JavaScript heap small on a 2 GB server.
ENV NODE_ENV=production \
    NODE_OPTIONS=--max-old-space-size=256 \
    GATEWAY_HOST=0.0.0.0 \
    GATEWAY_PORT=5180
USER node
EXPOSE 5180
CMD ["node", "src/main.ts"]
