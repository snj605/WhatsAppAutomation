# Copy to /opt/whatsapp/.env on the server (setup-server.sh does this and fills in random secrets).
# This example file is in git; the real .env never is. Keep it readable only by its owner (chmod 600).

# Public address. Without a domain: <static-ip-with-dashes>.sslip.io, for example 13-233-10-20.sslip.io
SITE_HOST=13-233-10-20.sslip.io
# GitHub user that owns the images (lowercase).
IMAGE_OWNER=snj605
# Image version: written by deploy.sh on every deployment.
TAG=latest

# Secrets: random values, made by setup-server.sh. Changing AUTH_SIGNING_KEY signs everyone out;
# changing GATEWAY_AUTH_KEY means every WhatsApp number must be linked again.
POSTGRES_PASSWORD=
AUTH_SIGNING_KEY=
GATEWAY_SECRET=
GATEWAY_AUTH_KEY=

# Optional: MediatR licence key (free Community licence for small businesses).
MEDIATR_LICENSE_KEY=
