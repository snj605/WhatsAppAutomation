{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Auth": {
    "Issuer": "whatsappautomation",
    "Audience": "whatsappautomation-clients",
    "SigningKey": "",
    "AccessTokenLifetime": "00:10:00",
    "RefreshTokenLifetime": "30.00:00:00"
  },
  "Gateway": {
    "BaseUrl": "http://127.0.0.1:5180",
    "Secret": ""
  },
  "Broadcasting": {
    "Enabled": true,
    "TimeZone": "Asia/Kolkata",
    "SendFrom": "09:00",
    "SendUntil": "20:00",
    "MinDelaySeconds": 45,
    "MaxDelaySeconds": 120,
    "BatchSize": 10,
    "BatchRestMinMinutes": 10,
    "BatchRestMaxMinutes": 20,
    "DailyCap": 150,
    "WarmUpCaps": [ 20, 40, 75 ],
    "ContactGapDays": 0,
    "MaxFailuresInRow": 3
  }
}
